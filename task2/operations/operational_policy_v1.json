    },
    {
      "id": "D14",
      "topic": "持续性加重",
      "status": "interface_ready_value_pending",
      "rule": "14日内风险日数量驱动可配置倍率；默认保持1。"
    },
    {
      "id": "D15",
      "topic": "恢复机制",
      "status": "implemented_for_review",
      "rule": "只有存在有效暴露且当日无风险时允许有限回分；风险日不得因平滑反而加分。"
    },
    {
      "id": "D16",
      "topic": "低暴露与停驶",
      "status": "implemented_for_review",
      "rule": "低暴露向50分先验收缩并标记；零暴露冻结上一有效分。"
    },
    {
      "id": "D17",
      "topic": "核查豁免",
      "status": "implemented_for_review",
      "rule": "待核事件在3日内挂起不扣，达到期限仍未核则转有效；确认豁免永不扣。"
    }
  ]
