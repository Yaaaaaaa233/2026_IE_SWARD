  "decisions": [
    {
      "id": "D12",
      "topic": "时段系数",
      "status": "interface_ready_value_pending",
      "rule": "官方时段边界已实现；默认系数全部为1，真实系数只在训练折学习。"
    },
    {
      "id": "D13",
      "topic": "EWMA半衰期",
      "status": "candidate_set_ready",
